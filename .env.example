# Server Configuration
PORT=3000

# PostgreSQL Database Connection String
# Example: postgresql://postgres:password@localhost:5432/drskart
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/drskart

# Authentication Secret
JWT_SECRET=supersecretjwtkey_change_me_in_production

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=

# Nodemailer / SMTP (Optional - logs OTP to console if not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Twilio SMS (Optional - logs SMS OTP to console if not configured)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

